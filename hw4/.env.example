# Copy this file to .env (in hw4/ or hw4/backend/) and replace the placeholders.
# Never commit the real .env.

# Portkey gateway key used for the OpenAI model calls
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: override the chat model (default gpt-5.6-luna)
# CC_MODEL=gpt-5.6-luna

# Optional: set to 1 when serving over HTTPS so the session cookie is Secure
# CC_COOKIE_SECURE=0
